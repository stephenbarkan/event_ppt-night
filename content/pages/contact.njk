{% extends "layouts/page.njk" %}

{# Nested Components ------------------------------------------------------------------------------------------------------------------- #}

{% from "components/container.njk" import container %}
{% from "components/button.njk" import button %}
{% from "components/radio.njk" import radio %}
{% from "components/radioTile.njk" import radioTile %}
{% from "components/checkbox.njk" import checkbox %}
{% from "components/input.njk" import input %}
{% from "components/incrementer.njk" import incrementer %}
{% from "components/textarea.njk" import textarea %}
{% from "components/divider.njk" import divider %}

{# Content Source -------------------------------------------------------------------------------------------------------------------------- #}

{% set data = cms.contactPage %}

{# Values ------------------------------------------------------------------------------------------------------------------------------ #}

{# Theme ------------------ #}

{% set mainStyles = "pb-xl" %}
{% set formStyles = "py-xl px-base-x border border-neutral-light" %}
{% set fieldsStyles = "gap-lg max-w-content" %}
{% set submitButtonProps = {
    label: "Submit",
    size: "base"
} %}

{# Other ------------------ #}

{% set comma = joiner() %}
{% set xData %}
    {%- for item in data.formFields -%}
        {{ comma() }}
        {%- if item.macro == 'input' or item.macro == 'textarea' -%}
            {{- item.props.name -}}: ''
        {%- elseif item.macro == 'incrementer' -%}
            {{- item.props.name -}}: {{ item.props.fieldAttrs.min or 0 }}
        {%- elseif item.macro == 'checkbox' -%}
            {{- item.props.name -}}: []
        {%- elseif item.macro == 'radio' or item.macro == 'select' or item.macro == 'radioTile'  -%}
            {{- item.props.name -}}: {}
        {%- endif -%}
    {%- endfor -%}
{% endset %}

{# ------------------------------------------------------------------------------------------------------------------------------------- #}

{# {% block pageTitle %}{% endblock pageTitle %} #}

{% block pageContent %}

    {% call section({}, {id:"contact"}) %}
        {% call container({size:"base", type: "cols-1", alignment: "center"}) %}

                {# White box ------------------ #}
                <form
                    x-data="{ {{- xData -}} }"
                    name="contact"
                    method="POST"
                    action="/success"
                    netlify
                    tabindex="0"
                    class="flex justify-center w-full {{ formStyles }}">

                    {# Fields #}
                    <div class="flex flex-col items-center w-full {{ fieldsStyles }}">
                        {% for item in data.formFields %}
                            {% if item.showCondition %}<template class="w-full" x-if="{{ item.showCondition }}">{% endif %}
                                {% if item.macro == "input" %}
                                    {{ input(props=item.props, attrs={class:"w-full"}) }}
                                {% elseif item.macro == "incrementer" %}
                                    {{ incrementer(props=item.props, attrs={class:"w-full"}) }}
                                {% elseif item.macro == "checkbox" %}
                                    {{ checkbox(props=item.props, attrs={class:"w-full"}) }}
                                {% elseif item.macro == "radio" %}
                                    {{ radio(props=item.props, attrs={class:"w-full"}) }}
                                {% elseif item.macro == "radioTile" %}
                                    {{ radioTile(props=item.props, attrs={class:"w-full"}) }}
                                {% elseif item.macro == "textarea" %}
                                    {{ textarea(props=item.props, attrs={class:"w-full"}) }}
                                {% elseif item.macro == "select" %}
                                    {{ select(props=item.props, attrs={class:"w-full"}) }}
                                {% elseif item.macro == "submit" %}
                                    {{ button(props=item.props | assign(submitButtonProps), attrs={type:"submit", class:"w-full"}) }}
                            {% endif %}
                            {% if item.showCondition %}</template>{% endif %}
                        {% endfor %}
                    </div>
                </form>
        {% endcall %}
    {% endcall %}

{% endblock %}
