{% extends "layouts/document.njk" %}

{# Nested Components ------------------------------------------------------------------------------------------------------------------- #}

{% from "components/articleCard.njk" import articleCard %}
{% from "components/icon.njk" import icon %}

{# Content Source -------------------------------------------------------------------------------------------------------------------------- #}

{% set data = cms.searchPage %}

{# Values ------------------------------------------------------------------------------------------------------------------------------ #}

{% set mainAttrs %}
    x-data="{
        q: new URLSearchParams(window.location.search).get('q') ? new URLSearchParams(window.location.search).get('q').toLowerCase() : null,
        results: 0,
    }"
{% endset %}

{# ------------------------------------------------------------------------------------------------------------------------------------- #}

{% block pageTitle %}
    <h1 x-show="!q" class="text-heading-lg">Search works</h1>
    <h1 x-show="q" class="text-heading-lg"><span x-text="results"></span> search result<span x-show="results > 1">s</span> for ‘<span x-text="q"></span>’</h1>
{% endblock pageTitle %}

{% block tableOfContents %}{% include "snippets/archiveSidebar.njk" %}{% endblock tableOfContents %}

{% block documentContent %}
    <ul
    x-cloak
    class="grid gap-2xs" style="grid-template-columns: repeat( auto-fill, minmax(250px, 1fr) );">

        {# empty state #}
        <template x-if="!results && q">
            <div class="grid justify-items-center text-body-lg col-span-full gap-xs py-xl">
            {{ icon({glyph:"frame_exclamation"}) }}
            <h2 class="text-center">No search results</h2>
            </div>
        </template>

        {# no query state #}
        <template x-if="!q">
            <div class="grid justify-items-center text-body-lg col-span-full gap-xs py-xl">
            {# {{ icon({glyph:"frame_exclamation"}) }} #}
            <h2 class="text-center">Search results will show here.</h2>
            </div>
        </template>


        {# cards #}
        {% for post in collections.post %}
            {% set condition %}'{{post.data.title | lower }}'.includes(q) || '{{ post.data.tags | string | lower }}'.includes(q){% endset %}
            <template x-if="{{condition}}">
            {{ articleCard({
                href: post.url,
                title: post.data.title,
                eyebrow: post.data.tags | tagsList | join(", "),
                figure: {
                    image: 'https://penguinui.s3.amazonaws.com/component-assets/carousel/default-slide-1.webp',
                    alt: 'Vibrant abstract painting with swirling blue and light pink hues on a canvas.',
                    aspect: "aspect-5/4"
                }
            },{ "x-init":"results++"}) }}
            </template>
        {% endfor %}
    </ul>
{% endblock documentContent %}
