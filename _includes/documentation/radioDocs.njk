{# Nested Components -------------------------------------------------------------------------------------------------------------------------- #}

{% from "components/_componentDocumentation.njk" import componentDocumentation %}
{% from "components/radio.njk" import radio, radioMeta %}
{% from "components/markdown.njk" import markdown %}

{# ------------------------------------------------------------------------------------------------------------------------------------- #}

{% call componentDocumentation({
    title: "radio",
    meta: radioMeta
}) %}
    <div
        x-data="{documentationRadio: {} }"
        class="grid items-center w-full grid-cols-subgrid grid-col-full">
        {{ radio(
            props={
                name: "documentationRadio",
                label: "Radio",
                description: "Optional description",
                options: [{label: "Option 1", value: "You selected option 1!"},{label: "Option 2", value: "You selected option 2!"},{label: "Option 3", value: "You selected option 3!"}],
                fieldAttrs: {}
            },
            attrs={class:"w-max justify-self-center grid-col-content"}
        ) }}
        {% call markdown(
            props={transform: false, overrides:{preRadius:"0"} },
            attrs={class:"relative grid-col-full -bottom-base-x -mx-px"}
        ) %}
        <pre>
<code>output: <span x-show="!documentationRadio">{}</span><span x-show="documentationRadio"><span x-text="JSON.stringify(documentationRadio)"></span></span>
</code></pre>
        {% endcall %}
    </div>
{% endcall %}
